# ---------- Server ----------
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/kontaa
# Tests refuse to run unless this URI contains "test"; collections are wiped between tests.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/kontaa_test
CLIENT_URL=http://localhost:5173
# Extra allowed origins, comma separated (CLIENT_URL is always allowed)
CORS_ORIGINS=
# Set to 1 (or true) behind a single reverse proxy so req.ip and rate limits see the real client
TRUST_PROXY=false

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true in production; must be true whenever served over HTTPS
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Email. Leave SMTP_HOST empty in development to print emails (with their links) to the server console.
# Production refuses to start sending without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Kontaa <no-reply@example.com>

# Exchange rates: "none" = manual rates only. "open_er_api" enables a "Get today's rate" button using
# open.er-api.com (free, no key; only the currency pair is sent). Provider rates are mid-market estimates.
EXCHANGE_RATE_PROVIDER=none

# Receipt uploads (JPG, PNG, WebP, PDF; checked by file content). Path is relative to server/.
# Local disk only: use a persistent volume in production, or replace the storage module with object storage.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# The API runs recurring schedules every 15 minutes. Set to true on extra instances if you
# only want one to do it (running several is safe; occurrences are never created twice).
DISABLE_SCHEDULER=false

# ---- Subscription payments (Kontaa's own plans only; never Susu) ----
# A provider is offered only when its keys are set. Use test keys (sk_test_..., FLWSECK_TEST-...) until
# your merchant account is approved. Keys stay on the server; the browser never sees them.
PAYSTACK_SECRET_KEY=
# Paystack webhook URL to set in the dashboard: https://<api-host>/api/payments/webhooks/paystack
FLUTTERWAVE_SECRET_KEY=
# Flutterwave: set the same value as "Secret hash" in the dashboard. Webhook URL: https://<api-host>/api/payments/webhooks/flutterwave
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_API_TIMEOUT_MS=15000

# Plan prices as plan.period=amount (decimal strings). A plan/period without a price can't be bought.
# Example values only; set your real prices.
PLAN_CURRENCY=GHS
PLAN_PRICES=personal_pro.monthly=25.00,personal_pro.yearly=250.00,business_pro.monthly=75.00,business_pro.yearly=750.00
# Optional JSON overrides for plan limits (null = unlimited), e.g. {"free":{"accounts":8}}
PLAN_LIMITS=
# Days a lapsed plan keeps working while the owner renews (not after a cancellation).
SUBSCRIPTION_GRACE_DAYS=3
# Days before the end of a paid period to remind owners to renew.
RENEWAL_REMINDER_DAYS=7

# ---- Optional AI assistant (read-only; answers from server-calculated figures) ----
# Off by default. Set AI_PROVIDER=anthropic and ANTHROPIC_API_KEY to enable. Each user must agree before use,
# and owners/admins can switch it off per workspace. Only summary figures are sent (no payees, descriptions,
# notes or files). Questions and answers are not stored. Monthly question caps come from the plan limits.
AI_PROVIDER=none
ANTHROPIC_API_KEY=

AI_MODEL=claude-opus-5-5
# low | medium | high reasoning effort
AI_EFFORT=medium
AI_TIMEOUT_MS=90000

# Interactive API docs at /api/docs and /api/openapi.json. Defaults to on outside production, off in production.
API_DOCS=

# Bump when the legal text changes; new consents are recorded against these versions.
TERMS_VERSION=2026-11-01
PRIVACY_VERSION=2026-11-11.2
